---
import Layout from '../layouts/Layout.astro';
const baseUrl = Astro.baseUrl || '/';
---

<Layout title="404 - Page Not Found - Sven Co-op Map Database">
  <div className="app-container" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 70vh; text-align: center; padding: 40px 20px;">
    <h1 style="font-size: 4rem; color: var(--accent); margin-bottom: 10px; font-family: var(--font-mono, monospace);">404</h1>
    <h2 style="font-size: 1.5rem; margin-bottom: 15px;">Página no encontrada / Page Not Found</h2>
    <p style="margin-bottom: 30px; color: var(--text-secondary); max-width: 500px;">
      El mapa o la página que estás buscando no existe o ha sido movida.
    </p>
    <a href={baseUrl} className="btn btn-primary" style="text-decoration: none; padding: 10px 20px; font-weight: bold;">
      ← Volver al inicio / Back to Home
    </a>
  </div>
</Layout>
